/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hltb-calendar-cf",
	"main": "src/api/index.ts",
	"compatibility_date": "2026-05-04",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {  "directory": "./dist/",  "binding": "ASSETS" },
	"vars": {
		"PROXY_BASE_URL": "https://proxy.howlongtobeatcalendar.com"
	},
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER_AUTH",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 10, "period": 60 }
			},
			{
				"name": "RATE_LIMITER_HLTB",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": { "limit": 30, "period": 60 }
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hltb-calendar",
			"database_id": "a3ab29db-4f3f-431a-a946-018f69c5f001",
			"migrations_dir": "src/api/migrations"
		}
	]
}